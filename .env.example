# --- BreakWall env ---
# Copy to .env and fill in secrets. Never commit .env.
GROQ_API_KEY=

# Groq models (llama-3.3-70b-versatile / llama-3.1-8b-instant are deprecated on Groq)
GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
GROQ_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m

# Infra
DATABASE_URL=postgres://breakwall:breakwall@localhost:5432/breakwall
REDIS_URL=redis://localhost:6379
POSTGRES_USER=breakwall
POSTGRES_PASSWORD=breakwall
POSTGRES_DB=breakwall
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Gateway (apps/gateway)
GATEWAY_PORT=8787
GATEWAY_UPSTREAM=https://api.groq.com
GATEWAY_RATE_LIMIT=60
GATEWAY_RATE_WINDOW_MS=60000
GATEWAY_CACHE_MAX=1000
CACHE_SIM_THRESHOLD=0.92
GUARD_TIMEOUT_MS=8000

# Guardrails (services/guardrails)
GUARDRAILS_PORT=8000
GUARDRAILS_URL=http://localhost:8000
GUARD_BLOCK_THRESHOLD=0.85
GUARD_REVIEW_THRESHOLD=0.45
GUARD_TIMEOUT_S=6
JUDGE_TIMEOUT_S=12
# Fail closed (block) instead of fail open when guardrails is unreachable
GUARD_STRICT=0
