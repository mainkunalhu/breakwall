{
  "name": "breakwall",
  "version": "0.0.0",
  "private": true,
  "description": "BreakWall — Red-Team + Eval Harness for Groq LLMs (TUI-first)",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:gateway": "bun --filter gateway dev",
    "build": "bun --filter '*' build",
    "test": "bun --filter '*' test",
    "test:py": "(cd services/guardrails && uv run pytest -q) && (cd services/eval-runner && uv run pytest -q)",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "bun --filter '*' typecheck",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "typescript": "5.6.3"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
